# Copy this file to .env.local and fill in the values from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only; leave unset unless the backend explicitly requires it.
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Google OAuth + Calendar (server-only)
# Create a Web OAuth client in Google Cloud and add this redirect URI:
# http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
